@{
    ViewData["Title"] = "Login";
}

<div class="row">
    <div class="container">
        @if (!string.IsNullOrEmpty((string?)TempData["Error"])) {
            <div class="alert alert-dismissible alert-danger">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <strong>@TempData["Error"]</strong>
            </div>
        }
        <form class="input-group" asp-action="LoginPost" asp-controller="Account">
            <fieldset>
                <label for="in_Email" class="form-label">Email</label>
                <input id="in_Email" name="email" type="email" class="form-control" placeholder="Email..."/>
                <label for="in_Password" class="form-label">Password</label>
                <input id="in_Password" name="password" type="password" class="form-control" placeholder="Password..."/>
                <!--Submit-->
                <div class="row mb-1 mt-1">
                    <small>
                        Don't have an account? <a asp-controller="Account" asp-action="Signup">Sign Up</a>
                    </small>
                    <button type="submit" class="btn btn-primary">Log in</button>
                </div>
            </fieldset>
        </form>
    </div>
</div>