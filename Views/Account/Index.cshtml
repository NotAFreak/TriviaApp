@using System.Security.Claims
@{
    ViewData["Title"] = "Account";
}

<div class="row">
    <h1>Manage Account</h1>
    <div class="col-md-6">
        <h2>Update Info</h2>
        <form asp-action="UpdateInfoPost" asp-controller="Account">
            <fieldset>
                <div>
                    <label for="in_updUsername" class="form-label">Username (Optional): </label>
                    <input id="in_updUsername" name="username" oninput="SetAccountInfoDirty(true)" class="form-control" type="text" placeholder="Username..." value="@User.FindFirst("username")?.Value"/>
                </div>
                <div class="mt-2">
                    <label for="in_updEmail" class="form-label">Email (Optional): </label>
                    <input id="in_updEmail" name="email" oninput="SetAccountInfoDirty(true)" class="form-control" type="email" placeholder="Email..." value="@User.FindFirst(ClaimTypes.Email)?.Value"/>
                </div>
                <div class="mt-2">
                    <label for="in_updPassword" class="form-label">Password (Optional): </label>
                    <input id="in_updPassword" name="password" oninput="SetAccountInfoDirty(true)" class="form-control" type="password" placeholder="Password..." value=""/>
                </div>
                <div class="mt-2">
                    <label for="p_Role" class="form-label">Role: </label>
                    <p id="p_Role">@User.FindFirst(ClaimTypes.Role)?.Value</p>
                </div>
            </fieldset>
            <hr/>
            <div class="mt-2 mb-3">
                <label for="in_ConfirmPassword" class="form-label">Confirm Password: </label>
                <input id="in_ConfirmPassword" name="confirmPassword" oninput="SetAccountInfoDirty(true)" class="form-control" type="password" placeholder="Password..."/>
            </div>
            <button type="submit" id="btn_UpdateChanges" onclick="SetAccountInfoDirty(false)" class="btn btn-success disabled">Update Changes</button>
        </form>
    </div>
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty((string?)TempData["Error"])) {
            <div class="alert alert-dismissible alert-danger">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <strong>@TempData["Error"]</strong>
            </div>
        }
        <form asp-action="LogoutPost" asp-controller="Account">
            <button type="submit" class="btn btn-danger" asp-controller="Account" asp-action="LogoutPost">Logout</button>
        </form>
        <button type="button" class="btn btn-danger mt-2" data-bs-toggle="modal" data-bs-target="#delete-account-modal">
            Delete Account
        </button>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="delete-account-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="DeleteAccountPost" asp-controller="Account" method="post">
                <div class="modal-body">
                    <div class="row ps-2">
                        <h6>Are you sure you'd Like to delete your account?</h6>
                    </div>
                    <div class="row ps-2 input-group">
                        <label for="in_Password">Password</label>
                        <input id="in_Password" type="password" autocomplete="false" name="password" class="form-control"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger float-start">Delete</button>
                    <button type="button" class="btn btn-primary float-end" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function SetAccountInfoDirty(isDirty) {
            let button = document.getElementById("btn_UpdateChanges");
            
            let confirmPassword = document.getElementById("in_ConfirmPassword");
            if(confirmPassword.value === "") {
                isDirty = false;
            }
            if(isDirty) {
                button.classList.remove("disabled");
            } else {
                button.classList.add("disabled");
            }
        }
    </script>
}
