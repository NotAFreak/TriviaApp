@using System.Globalization
@model TriviaApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
<h1>Home</h1>
<div class="d-flex">
    <div class="col-md-3 p-1">
        <h2>Leaderboards</h2>
        <div class="card mb-3 shadow">
            <h3 class="card-header text-center">Global Leaderboard</h3>
            <div class="card-body">
                
            </div>
        </div>
        <div class="card mb-3 shadow">
            <h3 class="card-header text-center">Daily Leaderboard</h3>
            <div class="card-body">

            </div>
        </div>
    </div>
    <hr class="vr"/>
    <div class="col-md-6 p-1">
        <h2>Questions</h2>
        <!--Daily APIQuestion-->
        <div>
            <div id="spin_DailyQuestion" class="align-self-center spinner-border spinner-border-sm" role="status" style=" visibility: collapse">
            </div>
            <div id="crd_StartDailyQuestion" class="card mb-3 shadow" style="visibility: visible;">
                <h3 class="card-header text-center">Daily Question</h3>
                <div class="card-body">
                    <button type="button" onclick="StartDailyQuestion()" class="btn btn-primary float-end">Start</button>
                </div>
                <div class="card-footer">
                    
                </div>
            </div>
            <div id="crd_CorrectDailyQuestion" class="card mb-3 text-white shadow bg-success" style="visibility: collapse;">
                <h3 class="card-header text-center">Daily Question</h3>
                <div class="card-body">
                    <h4>Correct!</h4>
                </div>
            </div>
            <div id="crd_IncorrectDailyQuestion" class="card mb-3 text-white shadow bg-danger" style="visibility: collapse;">
                <h3 class="card-header text-center">Daily Question</h3>
                <div class="card-body">
                    <h4>Incorrect.</h4>
                </div>
            </div>
            <div id="crd_DailyQuestion" class="card mb-3 shadow" style="visibility: collapse;">
                <h3 class="card-header text-center">Daily Question</h3>
                <div class="card-body">
                    <h4>Question</h4>
                    <hr/>
                    <h5 id="txt_DailyQuestion">QUESTION HERE?</h5>
                </div>
                <div class="card-body">
                    <h4>Answers</h4>
                    <hr/>
                    <div id="dv_AnswerContainer" class="row">
                        <div class="col-md ms-auto">
                            <input type="radio" autocomplete="false" class="btn-check" name="btn_DailyQuestion" id="btn_DailyQuestion1"/>
                            <label class="btn btn-outline-primary" for="btn_DailyQuestion1">Answer</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="btn_DailyQuestionSubmit" type="button" onclick="SubmitDailyQuestion()" class="btn btn-primary float-end">Submit</button>
                </div>
            </div>
            <div id="alrt_NoDailyQuestion" class="alert alert-dismissible alert-secondary mb-3 shadow" style="visibility: collapse">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <p>Already completed today's trivia question</p>
            </div>
        </div>
    </div>
    <hr class="vr"/>
    <div class="col-md-3 p-1">
        <h2>Statistics</h2>
        @if (User.Identity is not null && User.Identity.IsAuthenticated) {
            <div class="card h-100 mb-3 shadow">
                <h3 class="card-header text-center">@(User.FindFirst("username")?.Value)'s Statistics</h3>
                <div class="card-body">
                    <h4>Scores</h4>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.TotalAnswered.ToString(CultureInfo.InvariantCulture)</label>
                        <label class="">Total Answered: </label>
                    </div>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.TotalCorrect.ToString(CultureInfo.InvariantCulture)</label>
                        <label>Total Correct: </label>
                    </div>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.TotalIncorrect.ToString(CultureInfo.InvariantCulture)</label>
                        <label>Total Incorrect: </label>
                    </div>
                </div>
                <div class="card-body">
                    <h4>Times</h4>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.AverageAnswerTime.ToString(CultureInfo.InvariantCulture)s</label>
                        <label>Average Answer Time: </label>
                    </div>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.MinimumAnswerTime.ToString(CultureInfo.InvariantCulture)s</label>
                        <label>Minimum Answer Time: </label>
                    </div>
                    <div class="form-horizontal">
                        <label class="float-end">@Model.MaximumAnswerTime.ToString(CultureInfo.InvariantCulture)s</label>
                        <label>Maximum Answer Time: </label>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        function ShowLoading() {
            document.getElementById("spin_DailyQuestion").style.visibility = "visible";
        }
        function HideLoading() {
            document.getElementById("spin_DailyQuestion").style.visibility = "collapse";
        }
        @* document.addEventListener("DOMContentLoaded", function() { *@
        @*     GetDailyQuestion(); *@
        @* }); *@
        
        function SubmitDailyQuestion() {
            let radioButton = document.querySelector('input[name="btn_DailyQuestion"]:checked');
            if(radioButton == null) return;
            ShowLoading()
            $.ajax({
                url:"/Home/SubmitDailyQuestion",
                dataType: "json",
                data: {
                    answerId: radioButton.value
                },
                success: SubmitDailyQuestionCallback
            })
        }
        function SubmitDailyQuestionCallback(data, status) {
            let d = JSON.parse(data);
            
            HideLoading();
            console.log("got callback from submitting question");
            switch (d.state) {
                case 0: // Unknown
                    break;
                case 1: // Correct
                    document.getElementById("crd_CorrectDailyQuestion").style.visibility = "visible";
                    break;
                case 2: // Incorrect
                    document.getElementById("crd_IncorrectDailyQuestion").style.visibility = "visible";
                    break;
                case 3: // Out of time
                    break;
            }
        }
        
        function StartDailyQuestion() {
            document.getElementById("crd_StartDailyQuestion").style.visibility = "collapse";
            GetDailyQuestion();
        }

        function DisplayDailyAPIQuestionCallback(data, status) {
            let d = JSON.parse(data);
            if(d.HasCompleted) {
                document.getElementById("crd_DailyQuestion").style.visibility = "collapse";
                document.getElementById("alrt_NoDailyQuestion").style.visibility = "visible";
            } else {
                document.getElementById("crd_DailyQuestion").style.visibility = "visible";
                document.getElementById("alrt_NoDailyQuestion").style.visibility = "collapse";
                
                document.getElementById("txt_DailyQuestion").innerHTML = d.question.Text;
                let answerContainer = document.getElementById("dv_AnswerContainer");
                answerContainer.innerHTML = "";
                for(let i = 0; i < d.question.Answers.length; i++) {
                    let answer = d.question.Answers[i];
                    let answerElement = document.createElement("div");
                    answerElement.setAttribute("class", "col-md ms-auto")
                    answerElement.innerHTML = '' +
                        '    <input type="radio" autocomplete="false" value="' + answer.AnswerID + '" class="btn-check" name="btn_DailyQuestion" id="btn_DailyQuestion' + i + '"/>\n' +
                        '    <label class="btn btn-outline-primary" for="btn_DailyQuestion' + i + '">' + answer.Text + '</label>\n';
                    answerContainer.appendChild(answerElement);
                }
            }
            HideLoading();
        }
        function GetDailyQuestion() {
           ShowLoading();
            $.ajax({
                url:"/Home/GetDailyQuestion",
                dataType: "json",
                success: DisplayDailyAPIQuestionCallback
            })
        }
    </script>
}
